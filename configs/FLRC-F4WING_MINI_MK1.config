# Gripora / STM32F405 (S405) 4.6.0-0.0.17 Aug 31 2026 / 12:02:50 (213cd51) MSP API: 22.2

board_name F4WING_MINI_MK1
board_design WGFL
manufacturer_id FLRC

# FlyingRC F4Wing Mini MK1. Outputs by pad: S1 PC9 and S2 PC8 (TIM8), S3 PB15 and S4 PA8 (TIM1),
# S5 PB11 and S6 PB10 (TIM2, the ESC pair), S12 PB1 (TIM3, LED strip). No buzzer, blackbox
# flash, SD card or on-board BEC.

# resources
resource MOTOR 1 B11
resource MOTOR 2 B10
resource SERVO 1 C09
resource SERVO 2 C08
resource SERVO 3 B15
resource SERVO 4 A08
resource LED_STRIP 1 B01
resource PPM 1 A03
resource SERIAL_TX 1 A09
resource SERIAL_TX 4 A00
resource SERIAL_TX 5 C12
resource SERIAL_RX 1 A10
resource SERIAL_RX 2 A03
resource SERIAL_RX 4 A01
resource SERIAL_RX 5 D02
resource I2C_SCL 1 B08
resource I2C_SDA 1 B07
resource LED 1 A14
resource LED 2 A13
resource SPI_SCK 1 A05
resource SPI_MISO 1 B04
resource SPI_MOSI 1 A07
resource ADC_BATT 1 C04
resource ADC_CURR 1 C05
resource GYRO_EXTI 1 C15
resource GYRO_CS 1 C14

# timer
timer C09 AF3
# pin C09: TIM8 CH4 (AF3)
timer C08 AF3
# pin C08: TIM8 CH3 (AF3)
timer B15 AF1
# pin B15: TIM1 CH3N (AF1)
timer A08 AF1
# pin A08: TIM1 CH1 (AF1)
timer B11 AF1
# pin B11: TIM2 CH4 (AF1)
timer B10 AF1
# pin B10: TIM2 CH3 (AF1)
timer B01 AF2
# pin B01: TIM3 CH4 (AF2)
timer A03 AF3
# pin A03: TIM9 CH2 (AF3)

# dma
dma ADC 1 1
# ADC 1: DMA2 Stream 4 Channel 0
dma pin B11 0
# pin B11: DMA1 Stream 7 Channel 3

# feature
feature RX_SERIAL
feature TELEMETRY
feature DYN_NOTCH

# serial
serial 4 64 115200 57600 0 115200

# master
set mag_bustype = I2C
set mag_i2c_device = 1
set mag_hardware = NONE
set baro_bustype = I2C
set baro_i2c_device = 1
set baro_hardware = AUTO
set current_meter = ADC
set battery_meter = ADC
set vbat_scale = 210
set ibata_scale = 150
set system_hse_mhz = 8
set blackbox_device = NONE
set gyro_1_bustype = SPI
set gyro_1_spibus = 1
set gyro_1_sensor_align = CW270FLIP
set gyro_1_align_pitch = 1800
set gyro_1_align_yaw = 2700
set serialrx_provider = CRSF
set align_board_yaw = 270
